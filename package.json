{
  "name": "relay",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./sdk/index.d.ts",
      "import": "./sdk/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test sdk/index.test.js tests/unit/cli-input.test.mjs tests/unit/cli-config.test.mjs tests/unit/viewer-ack.test.mjs",
    "test:integration": "node tests/integration/integration.mjs",
    "test:framework": "node tests/integration/framework-integration.mjs",
    "test:cursor": "node tests/integration/cursor-integration.mjs",
    "test:portable": "node tests/integration/portable-integration.mjs",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "yaml": "2.9.1"
  }
}
