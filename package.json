{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    }
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "npm run build && node --test tests/unit/*.test.mjs",
    "test:e2e": "node tests/e2e/viewer.mjs",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "agent-browser": "0.40.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@vercel/detect-agent": "1.2.7",
    "yaml": "2.9.1"
  }
}
