{
  "name": "desktop-relay",
  "version": "0.0.1",
  "description": "Stream a desktop to a browser and control it from a CLI and a Node SDK.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vercel-labs/desktop-relay.git"
  },
  "type": "module",
  "bin": {
    "relay": "dist/cli/relay.mjs"
  },
  "files": [
    "dist",
    "skills",
    "packages.tsv"
  ],
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    }
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "npm run build && node --test tests/unit/*.test.mjs",
    "test:e2e": "node tests/e2e/viewer.mjs",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "agent-browser": "0.41.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@vercel/detect-agent": "1.2.7",
    "yaml": "2.9.1"
  }
}
