#!/usr/bin/env python3
"""relay: start a streamed Linux desktop and drive it from anywhere."""
import argparse
import ctypes
import ctypes.util
import fcntl
import json
import math
import os
from pathlib import Path
import re
import secrets
import select
import shlex
import shutil
import signal
import socket
import ssl
import struct
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
import zlib

DEFAULT_PORT = 8080
MAX_BATCH = 256
COMPONENTS = ('display', 'desktop', 'engine', 'apps')
TOKEN = re.compile(r'[0-9a-f]{64}')
HINTS = {
    'display': 'Check Xvfb and /tmp/.X11-unix with `relay doctor`.',
    'desktop': 'Run `relay doctor` (icon decoding, D-Bus) and read `relay logs desktop`.',
    'engine': 'If the port is taken, pick another with --port; otherwise run `relay doctor`.',
}


class Failure(Exception):
    """A user-facing error with a stable code, a fix hint and optional component details."""

    def __init__(self, code, message, hint='', **extra):
        super().__init__(message)
        self.code, self.message, self.hint, self.extra = code, message, hint, extra

    def payload(self):
        return {'code': self.code, 'message': self.message, 'hint': self.hint, **self.extra}


def emit(args, data, text):
    """Print the JSON object with --json, otherwise the human text."""
    print(json.dumps(data) if args.json else text, flush=True)


TYPES = {'keyDown': 1, 'keyUp': 2, 'pointerMove': 3, 'buttonDown': 4, 'buttonUp': 5, 'wheel': 6, 'releaseAll': 7}
US_KEYS = {c: 4 + i for i, c in enumerate('abcdefghijklmnopqrstuvwxyz1234567890')}
US_KEYS.update({'\n': 40, '\t': 43, ' ': 44})
US_KEYS.update({c: 45 + i for i, c in enumerate('-=[]\\')})
US_KEYS.update({c: 51 + i for i, c in enumerate(';\'`,./')})
SHIFTED = dict(zip('!@#$%^&*()_+{}|:"~<>?', '1234567890-=[]\\;\'`,./'))
MODIFIERS = {'ctrl': 224, 'control': 224, 'shift': 225, 'alt': 226, 'super': 227, 'meta': 227, 'cmd': 227, 'win': 227}
NAMED_KEYS = {'enter': 40, 'return': 40, 'escape': 41, 'esc': 41, 'backspace': 42, 'tab': 43, 'space': 44,
              'capslock': 57, 'printscreen': 70, 'scrolllock': 71, 'pause': 72, 'insert': 73, 'home': 74,
              'pageup': 75, 'delete': 76, 'end': 77, 'pagedown': 78, 'right': 79, 'left': 80, 'down': 81,
              'up': 82, 'menu': 101, 'arrowright': 79, 'arrowleft': 80, 'arrowdown': 81, 'arrowup': 82}
NAMED_KEYS.update({f'f{n}': 57 + n for n in range(1, 13)})
NAMED_KEYS.update({f'f{n}': 91 + n for n in range(13, 25)})


def number(value, name, low, high, integer=False):
    """Validate a JSON number the way the SDK does (finite, in range, optionally integral)."""
    if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value) \
            or not low <= value <= high or (integer and value != int(value)):
        raise Failure('invalid_input', f'Invalid {name}: {value!r}', f'Expected a number from {low} to {high}.')
    return value


def encode(event):
    """Encode one SDK-schema input event as the engine's 16-byte record (bytes 20-35 of sdk encodeInput)."""
    kind = TYPES.get(event.get('type')) if isinstance(event, dict) and isinstance(event.get('type'), str) else None
    if not kind:
        raise Failure('invalid_input', f'Unknown input event: {json.dumps(event)}', 'Types: ' + ', '.join(TYPES))
    code = value = x = y = 0
    if kind <= 2:
        code = int(number(event.get('key'), 'key', 0, 231, True))
    if 3 <= kind <= 6:
        x, y = (math.floor(number(event.get(a), a, 0, 1) * 65535 + 0.5) for a in 'xy')
    if kind in (4, 5):
        code = int(number(event.get('button'), 'button', 1, 3, True))
    if kind == 6:
        if event.get('axis') not in ('vertical', 'horizontal'):
            raise Failure('invalid_input', 'Invalid wheel axis', 'Use "vertical" or "horizontal".')
        value = int(number(event.get('delta'), 'wheel delta', -1200, 1200, True))
        if value % 120:
            raise Failure('invalid_input', 'Wheel delta must be a multiple of 120', 'One notch is 120.')
        code = 0 if event['axis'] == 'vertical' else 1
    return struct.pack('>BBHiHHHH', kind, 0, code, value, x, y, 0, 0)


def press(key, modifiers=()):
    """Events for pressing and releasing a key while holding modifiers."""
    return ([{'type': 'keyDown', 'key': m} for m in modifiers] + [{'type': 'keyDown', 'key': key}, {'type': 'keyUp', 'key': key}]
            + [{'type': 'keyUp', 'key': m} for m in reversed(modifiers)])


def char_key(char):
    """Map a character to (HID usage, needs shift) on a US layout, or None."""
    if char in US_KEYS:
        return US_KEYS[char], False
    if char.isascii() and char.isupper():
        return US_KEYS[char.lower()], True
    if char in SHIFTED:
        return US_KEYS[SHIFTED[char]], True
    return None


def type_groups(text):
    """One event group per character; rejects the whole text if any character has no US key."""
    keys = [char_key(c) for c in text]
    bad = sorted({repr(c) for c, k in zip(text, keys) if k is None})
    if bad:
        raise Failure('invalid_input', 'Cannot type ' + ', '.join(bad) + ' with a US keyboard layout',
                      'Only printable ASCII, newline and tab can be typed.')
    return [press(k, [225] if shift else []) for k, shift in keys]


def combo_events(spec):
    """Events for a combo like ctrl+l, shift+Tab, Enter or ctrl++."""
    if spec == '+' or spec.endswith('++'):
        held, key = spec[:-2], '+'
    else:
        held, _, key = spec.rpartition('+')
    names = held.split('+') if held else []
    unknown = [n for n in names if n.lower() not in MODIFIERS]
    if unknown or not key:
        raise Failure('invalid_input', f'Invalid key combo "{spec}"', 'Modifiers: ctrl, shift, alt, super. Example: ctrl+shift+t')
    modifiers = [MODIFIERS[n.lower()] for n in names]
    lower = key.lower()
    if lower in NAMED_KEYS or lower in MODIFIERS:
        return press(NAMED_KEYS.get(lower) or MODIFIERS[lower], modifiers)
    mapped = char_key(key) if len(key) == 1 else None
    if not mapped:
        raise Failure('invalid_input', f'Unknown key "{key}"', 'Use a character or a name like Enter, Tab, Escape, Up, F5.')
    return press(mapped[0], modifiers + ([225] if mapped[1] and 225 not in modifiers else []))


def batches(groups):
    """Pack event groups into batches of at most MAX_BATCH records without splitting a group."""
    batch = []
    for group in groups:
        if len(group) > MAX_BATCH:
            raise Failure('invalid_input', f'An input group has more than {MAX_BATCH} events', 'Split the input.')
        if len(batch) + len(group) > MAX_BATCH:
            yield batch
            batch = []
        batch += group
    if batch:
        yield batch


class NoRedirect(urllib.request.HTTPRedirectHandler):
    """Refuse redirects so credentials never reach another origin."""

    def redirect_request(self, *args, **kwargs):
        raise Failure('invalid_input', 'Server answered with a redirect; refusing to follow it', 'Use the server origin directly.')


def check_url(url, token):
    """Apply the SDK rules: HTTPS or loopback HTTP origin, no credentials or path, token for remote hosts."""
    try:
        parsed = urllib.parse.urlsplit(url)
        parsed.port
    except ValueError:
        parsed = None
    local = parsed is not None and parsed.hostname in ('localhost', '127.0.0.1')
    if not parsed or parsed.scheme not in ('http', 'https') or (not local and parsed.scheme != 'https') or not parsed.hostname \
            or parsed.username or parsed.password or parsed.path not in ('', '/') or parsed.query or parsed.fragment:
        raise Failure('invalid_input', f'Invalid server URL: {url}', 'Use an HTTPS origin or http://127.0.0.1:PORT.')
    if (token is not None and not TOKEN.fullmatch(token)) or (not local and not token):
        raise Failure('invalid_input', 'Remote servers need a 64-character lowercase hex token',
                      'Pass --token-file FILE or set RELAY_TOKEN_FILE.')
    return url.rstrip('/')


def connect_host(bind):
    """Address a local client dials for this listen address, or None for 127.0.0.1."""
    if bind in ('127.0.0.1', '0.0.0.0', '::', None):
        return None
    return f'[{bind}]' if ':' in bind else bind


def target(args):
    """Resolve (url, token, cafile, connect) from flags, environment, or the local session state."""
    url = args.url or os.environ.get('RELAY_URL')
    token_file = args.token_file or os.environ.get('RELAY_TOKEN_FILE')
    cafile = connect = None
    if not url:
        session = read_session(args.name) or {}
        if session.get('state') == 'ready':
            url, cafile, connect = session['localUrl'], session.get('tlsCert'), connect_host(session.get('bind'))
            token_file = token_file or session.get('tokenFile')
        else:
            url = f'http://127.0.0.1:{DEFAULT_PORT}'
    token = None
    if token_file:
        try:
            token = Path(token_file).read_text().strip()
        except OSError as error:
            raise Failure('invalid_input', f'Cannot read token file: {error}', 'Check --token-file.')
    return check_url(url, token), token, cafile, connect


def http(where, path, timeout, body=None, binary=False):
    """One request to the engine; maps HTTP and network errors to Failures."""
    url, token, cafile, connect = where
    headers = {'Authorization': 'Bearer ' + token} if token else {}
    request_url = url
    if connect:
        parts = urllib.parse.urlsplit(url)
        headers['Host'] = parts.netloc
        request_url = parts._replace(netloc=f'{connect}:{parts.port}').geturl()
    context = None
    if cafile:
        context = ssl.create_default_context(cafile=cafile)
        context.check_hostname = False
    opener = urllib.request.build_opener(NoRedirect, urllib.request.HTTPSHandler(context=context))
    request = urllib.request.Request(request_url + path, data=body, headers=headers, method='GET' if body is None else 'POST')
    try:
        with opener.open(request, timeout=timeout) as response:
            data = response.read(8 * 1024 * 1024 + 1)
    except urllib.error.HTTPError as error:
        try:
            detail = json.loads(error.read(4096))
        except ValueError:
            detail = {}
        known = {
            401: ('unauthorized', 'Token missing or wrong', 'Pass --token-file FILE or set RELAY_TOKEN_FILE.'),
            403: ('unauthorized', 'Rejected by the Host/Origin policy', 'Connect through a loopback address or the configured public URL.'),
            409: ('busy', 'A viewer or SDK session holds control', 'Close it and run the command again; input is never retried.'),
            413: ('invalid_input', 'Input batch too large', f'Send at most {MAX_BATCH} events per batch.'),
            503: ('busy', 'Engine busy or snapshot unavailable', 'Try again in a moment.'),
        }
        code, message, hint = known.get(error.code, ('internal', f'Engine returned HTTP {error.code}', ''))
        if 'index' in detail:
            code, message, hint = ('invalid_input', f'Engine rejected input event {detail["index"]} ({detail.get("error")})',
                                   'Check the event against the SDK input schema.')
        raise Failure(code, message, hint) from None
    except (urllib.error.URLError, OSError) as error:
        reason = getattr(error, 'reason', error)
        if isinstance(reason, (TimeoutError, socket.timeout)):
            raise Failure('timeout', f'No reply from {url} within {timeout:g}s', 'Raise --timeout or check the engine.') from None
        raise Failure('unreachable', f'Cannot reach {url}: {reason}', 'Start a session with `relay up` or pass --url.') from None
    if len(data) > 8 * 1024 * 1024:
        raise Failure('internal', 'Response exceeds 8 MiB')
    if binary:
        return data
    try:
        return json.loads(data)
    except ValueError:
        raise Failure('internal', 'Engine returned invalid JSON') from None


def send(args, groups):
    """Send event groups as bounded POST /input batches; reports how many events were applied."""
    where, applied = target(args), 0
    payloads = [b''.join(encode(e) for e in batch) for batch in batches(groups)]
    for payload in payloads:
        try:
            applied += http(where, '/input', args.timeout, body=payload)['applied']
        except Failure as failure:
            failure.extra['applied'] = applied
            raise
    return applied


def state_dir(name):
    """Per-session state directory under XDG_STATE_HOME."""
    if not re.fullmatch(r'[A-Za-z0-9_-][A-Za-z0-9_.-]{0,63}', name):
        raise Failure('invalid_input', f'Invalid session name "{name}"', 'Use letters, digits, ".", "_" or "-".')
    return Path(os.environ.get('XDG_STATE_HOME') or Path.home() / '.local/state') / 'relay' / name


def read_session(name):
    try:
        return json.loads((state_dir(name) / 'session.json').read_text())
    except (OSError, ValueError):
        return None


def write_session(directory, data):
    temporary = directory / 'session.json.tmp'
    temporary.write_text(json.dumps(data, indent=2) + '\n')
    os.replace(temporary, directory / 'session.json')


def tail(path, lines=20):
    try:
        with open(path, 'rb') as stream:
            stream.seek(max(0, os.fstat(stream.fileno()).st_size - 65536))
            return '\n'.join(stream.read().decode(errors='replace').splitlines()[-lines:])
    except OSError:
        return ''


def start_time(pid):
    """Process start time from /proc, or None when the process is gone or a zombie."""
    try:
        stat = Path(f'/proc/{pid}/stat').read_text()
        fields = stat[stat.rindex(')') + 2:].split()
        return None if fields[0] == 'Z' else fields[19]
    except (OSError, ValueError, IndexError):
        return None


def alive(record):
    return bool(record) and start_time(record['pid']) == record['start']


def identity(pid):
    return {'pid': pid, 'start': start_time(pid)}


def clear_ambient_caps():
    """Drop inherited ambient capabilities; bubblewrap (glycin image loaders) refuses to run with them."""
    if sys.platform.startswith('linux'):
        ctypes.CDLL(None).prctl(47, 4, 0, 0, 0)


def desktop_env(directory):
    """Environment shared by the desktop and apps started in a session; carries the marker `down` sweeps."""
    env = dict(os.environ, XDG_RUNTIME_DIR=str(directory / 'runtime'), XDG_CONFIG_HOME=str(directory / 'config'),
               XDG_CACHE_HOME=str(directory / 'cache'), ICEAUTHORITY=str(directory / 'ICEauthority'),
               RELAY_SESSION=str(directory))
    env.pop('DBUS_SESSION_BUS_ADDRESS', None)
    return env


def sweep(directory):
    """Kill leftover processes that carry this session's marker in their environment."""
    marker = f'RELAY_SESSION={directory}'.encode()
    for sig in (signal.SIGTERM, signal.SIGKILL):
        found = []
        for entry in Path('/proc').iterdir():
            try:
                if entry.name.isdigit() and int(entry.name) != os.getpid() and marker in (entry / 'environ').read_bytes().split(b'\0'):
                    os.kill(int(entry.name), sig)
                    found.append(entry.name)
            except (OSError, ValueError):
                pass
        if not found:
            return
        time.sleep(0.5)


def reap(directory, session):
    """Kill what a previous run of this session left behind; the caller holds the session lock."""
    for record in (session or {}).get('components', {}).values():
        if alive(record):
            try:
                os.killpg(record['pid'], signal.SIGKILL)
            except (ProcessLookupError, PermissionError):
                pass
    sweep(directory)


def find_engine():
    here = Path(__file__).resolve().parent
    for candidate in (here / 'relay-engine', here.parent / 'relay-engine'):
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return candidate
    found = shutil.which('relay-engine')
    return Path(found) if found else None


def start_xvfb(spawn, auth):
    """Start Xvfb on a free display (via -displayfd) with a private cookie; returns ':N'."""
    cookie = secrets.token_hex(16)

    def authorize(display):
        subprocess.run(['xauth', '-f', str(auth), 'add', display, '.', cookie], check=True,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    authorize(':0')
    read_fd, write_fd = os.pipe()
    try:
        process = spawn(['Xvfb', '-displayfd', str(write_fd), '-screen', '0', '1280x720x24', '-nolisten', 'tcp',
                         '-noreset', '-s', '0', '-auth', str(auth)], pass_fds=(write_fd,))
        os.close(write_fd)
        write_fd = None
        text, deadline = b'', time.monotonic() + 15
        while b'\n' not in text:
            if process.poll() is not None:
                raise Failure('component_failed', f'display exited with code {process.returncode}', HINTS['display'], component='display')
            if time.monotonic() > deadline or len(text) > 64:
                raise Failure('timeout', 'Xvfb did not report a display', HINTS['display'], component='display')
            if select.select([read_fd], [], [], 0.2)[0]:
                chunk = os.read(read_fd, 64)
                text += chunk or b'?\n'
    finally:
        os.close(read_fd)
        if write_fd is not None:
            os.close(write_fd)
    if not text.strip().isdigit():
        raise Failure('component_failed', 'Xvfb did not allocate a display', HINTS['display'], component='display')
    display = ':' + text.decode().strip()
    authorize(display)
    return display


def x_query(env, *command):
    try:
        return subprocess.run(command, env=env, capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ''


class Session:
    """One supervised run of display, desktop and engine, owned by this process."""

    def __init__(self, args, directory):
        self.args, self.dir = args, directory
        self.children, self.logs = {}, []
        self.data = {'name': args.name, 'state': 'starting', 'supervisor': identity(os.getpid()),
                     'logs': str(directory), 'port': args.port, 'components': {}}

    def save(self, **changes):
        self.data.update(changes)
        write_session(self.dir, self.data)

    def spawn(self, name, command, **options):
        log = open(self.dir / f'{name}.log', 'wb')
        self.logs.append(log)
        try:
            process = subprocess.Popen(command, env=self.env, stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                                       start_new_session=True, preexec_fn=clear_ambient_caps, **options)
        except OSError as error:
            raise Failure('component_failed', f'Cannot start {name}: {error}', HINTS[name], component=name) from None
        self.children[name] = process
        self.data['components'][name] = identity(process.pid)
        self.save()
        return process

    def failure(self, name, code, message):
        return Failure(code, message, HINTS[name], component=name, log=tail(self.dir / f'{name}.log'), logs=str(self.dir))

    def check_children(self):
        for name, process in self.children.items():
            if process.poll() is not None:
                raise self.failure(name, 'component_failed', f'{name} exited with code {process.returncode}')

    def start(self):
        args, directory = self.args, self.dir
        runtime = directory / 'runtime'
        shutil.rmtree(runtime, ignore_errors=True)
        runtime.mkdir(mode=0o700)
        self.env = desktop_env(directory)
        engine = find_engine()
        if not engine:
            raise Failure('missing_dependency', 'relay-engine not found', 'Run ./install.sh first.', component='engine')
        desktop = args.desktop or ('none' if args.display else 'xfce')
        command = ['xfce4-session'] if desktop == 'xfce' else [] if desktop == 'none' else shlex.split(desktop)
        needed = ([] if args.display else ['Xvfb', 'xauth']) + (['xprop', 'xwininfo', command[0]] if command else [])
        missing = [p for p in needed if not shutil.which(p)]
        if command and shutil.which('dbus-run-session'):
            command = ['dbus-run-session', '--', *command]
        elif desktop == 'xfce':
            missing.append('dbus-run-session')
        if missing:
            raise Failure('missing_dependency', 'Missing ' + ', '.join(missing), 'Run ./install.sh, or check with `relay doctor`.')
        if args.display:
            self.env['DISPLAY'] = args.display
        else:
            auth = directory / 'Xauthority'
            auth.write_bytes(b'')
            auth.chmod(0o600)
            self.env['XAUTHORITY'] = str(auth)
            try:
                self.env['DISPLAY'] = start_xvfb(lambda cmd, **kw: self.spawn('display', cmd, **kw), auth)
            except Failure as failure:
                raise self.failure('display', failure.code, failure.message) from None
        self.save(display=self.env['DISPLAY'], xauthority=self.env.get('XAUTHORITY'), ownsDisplay=not args.display, desktop=desktop)
        if command:
            self.spawn('desktop', command)
        bind = args.bind or ('0.0.0.0' if args.public else '127.0.0.1')
        token = None
        engine_command = [str(engine), '--bind', bind, '--port', str(args.port)]
        if bind != '127.0.0.1' or args.public:
            token = secrets.token_hex(32)
            token_file = directory / 'token'
            descriptor = os.open(token_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            os.fchmod(descriptor, 0o600)
            with os.fdopen(descriptor, 'w') as stream:
                stream.write(token + '\n')
            engine_command += ['--token-file', str(token_file)]
            self.data['tokenFile'] = str(token_file)
        if args.public:
            engine_command += ['--public-origin', args.public]
        if args.tls_cert:
            engine_command += ['--tls-cert', args.tls_cert, '--tls-key', args.tls_key]
        elif args.public:
            engine_command.append('--behind-tls-proxy')
        scheme = 'https' if args.tls_cert else 'http'
        local_url = f'{scheme}://127.0.0.1:{args.port}'
        self.save(bind=bind, localUrl=local_url, url=args.public or local_url,
                  tlsCert=os.path.abspath(args.tls_cert) if args.tls_cert else None)
        engine_process = self.spawn('engine', engine_command)
        self.wait_ready(engine_process.pid, (local_url, token, self.data['tlsCert'], connect_host(bind)), desktop)
        self.save(state='ready', ready=time.time())
        url = self.data['url']
        return {'ready': True, 'name': args.name, 'url': url, 'viewer': f'{url}/#token={token}' if token else url,
                'token': token, 'display': self.env['DISPLAY'], 'xauthority': self.env.get('XAUTHORITY'),
                'logs': str(directory), 'pid': os.getpid(), 'enginePid': engine_process.pid, 'bind': bind,
                'port': args.port, 'public': bool(args.public)}

    def engine_ready(self, pid, where):
        own = False
        for line in tail(self.dir / 'engine.log', 50).splitlines():
            if line.startswith('{'):
                try:
                    message = json.loads(line)
                except ValueError:
                    continue
                own |= message.get('ready') is True and message.get('pid') == pid
        if not own:
            return False
        try:
            return http(where, '/snapshot.png', 3, binary=True)[:8] == b'\x89PNG\r\n\x1a\n'
        except Failure:
            return False

    def desktop_ready(self, desktop):
        if desktop == 'xfce':
            found = x_query(self.env, 'xprop', '-root', '_NET_SUPPORTING_WM_CHECK', '_NET_CLIENT_LIST')
            return len(re.findall(r'window id # 0x', found)) >= 2
        match = re.search(r'(\d+) child', x_query(self.env, 'xwininfo', '-root', '-children'))
        return bool(match and int(match.group(1)))

    def wait_ready(self, pid, where, desktop):
        deadline = time.monotonic() + self.args.timeout
        pending = ['engine'] + (['desktop'] if desktop != 'none' else [])
        while pending:
            self.check_children()
            if pending[0] == 'engine' and self.engine_ready(pid, where) or pending[0] == 'desktop' and self.desktop_ready(desktop):
                pending.pop(0)
                continue
            if time.monotonic() > deadline:
                raise self.failure(pending[0], 'timeout', f'{pending[0]} not ready after {self.args.timeout:g}s')
            time.sleep(0.2)

    def supervise(self):
        while True:
            self.check_children()
            time.sleep(0.2)

    def cleanup(self):
        engine = self.children.get('engine')
        if engine and engine.poll() is None:
            engine.terminate()
            try:
                engine.wait(timeout=3)
            except subprocess.TimeoutExpired:
                pass
        processes = list(self.children.values())[::-1]
        for process in processes:
            try:
                os.killpg(process.pid, signal.SIGTERM)
            except (ProcessLookupError, PermissionError):
                pass
        for process in processes:
            try:
                process.wait(timeout=3)
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except (ProcessLookupError, PermissionError):
                    pass
                process.wait()
        sweep(self.dir)
        for log in self.logs:
            log.close()


def ready_text(info, args):
    lines = [f'relay "{info["name"]}" is ready', f'  url:     {info["url"]}', f'  viewer:  {info["viewer"]}']
    if info.get('token'):
        lines.append(f'  token:   {info["token"]}  (shown once; status --show-token prints it again)')
    lines += [f'  display: {info["display"]}', f'  logs:    {info["logs"]}']
    if info.get('public'):
        if not args.tls_cert:
            lines.append(f'Expects a TLS proxy in front: forward {info["url"]} to http://<this host>:{info["port"]}.')
    elif info.get('bind') != '127.0.0.1':
        lines.append(f'Listening on {info["bind"]}:{info["port"]}; reach it through a loopback port publish or SSH tunnel.')
    return '\n'.join(lines)


def require_linux():
    if not sys.platform.startswith('linux'):
        raise Failure('unsupported_platform', 'Host commands run on Linux only',
                      'Run this on the Linux machine; client commands (status, snapshot, click, ...) work anywhere with --url.')


def lock(name, directory):
    """Take the per-session lock that the supervisor holds for its whole life."""
    handle = open(directory / 'lock', 'a')
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        handle.close()
        raise Failure('already_running', f'Session "{name}" is already running',
                      f'Stop it with `relay down --name {name}` or pick another --name.') from None
    return handle


def cmd_up(args):
    require_linux()
    if not 1 <= args.port <= 65535:
        raise Failure('invalid_input', 'Port must be between 1 and 65535')
    if args.public and not re.fullmatch(r'https://[^/?#@\\\s]+', args.public):
        raise Failure('invalid_input', '--public must be an HTTPS origin like https://desk.example.com', 'No path, query or credentials.')
    if bool(args.tls_cert) != bool(args.tls_key):
        raise Failure('invalid_input', '--tls-cert and --tls-key go together')
    directory = state_dir(args.name)
    directory.mkdir(parents=True, mode=0o700, exist_ok=True)
    directory.chmod(0o700)
    ready_fd = int(os.environ.pop('RELAY_READY_FD', '-1'))
    if args.detach and ready_fd < 0:
        lock(args.name, directory).close()
        return detach(args, directory)

    def report(data):
        nonlocal ready_fd
        if ready_fd >= 0:
            os.write(ready_fd, (json.dumps(data) + '\n').encode())
            os.close(ready_fd)
            ready_fd = -1
            return True
        return False

    def stop(signum, frame):
        raise KeyboardInterrupt

    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, stop)
    try:
        held = lock(args.name, directory)
    except Failure as failure:
        report({'error': failure.payload()})
        raise
    reap(directory, read_session(args.name))
    session = Session(args, directory)
    final = {'state': 'stopped'}
    try:
        session.save()
        info = session.start()
        if not report(info):
            emit(args, info, ready_text(info, args) + '\nStop with Ctrl-C or `relay down`.')
        session.supervise()
    except KeyboardInterrupt:
        return 0
    except Exception as error:
        failure = error if isinstance(error, Failure) else Failure(
            'internal', f'{type(error).__name__}: {error}', 'Run `relay doctor`.', logs=str(directory))
        final = {'state': 'failed', 'error': failure.payload()}
        report({'error': failure.payload()})
        raise failure from None
    finally:
        for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
            signal.signal(sig, signal.SIG_IGN)
        session.cleanup()
        session.save(stopped=time.time(), **final)
        held.close()


def detach(args, directory):
    """Run the supervisor in the background and wait for its readiness handshake."""
    read_fd, write_fd = os.pipe()
    log_path = directory / 'supervisor.log'
    with open(log_path, 'wb') as log:
        process = subprocess.Popen([sys.executable, os.path.realpath(__file__), *sys.argv[1:]], pass_fds=(write_fd,),
                                   env=dict(os.environ, RELAY_READY_FD=str(write_fd)), stdin=subprocess.DEVNULL,
                                   stdout=log, stderr=log, start_new_session=True)
    os.close(write_fd)
    data, deadline = b'', time.monotonic() + args.timeout + 30
    with os.fdopen(read_fd, 'rb', buffering=0) as stream:
        while time.monotonic() < deadline:
            if not select.select([stream], [], [], 1)[0]:
                continue
            chunk = stream.read(65536)
            if not chunk:
                break
            data += chunk
    if not data:
        if process.poll() is None:
            process.terminate()
            raise Failure('timeout', 'Background supervisor did not report readiness in time', f'See {log_path}.',
                          component='supervisor', log=tail(log_path), logs=str(directory))
        raise Failure('component_failed', 'Background supervisor exited before it was ready', f'See {log_path}.',
                      component='supervisor', log=tail(log_path), logs=str(directory))
    result = json.loads(data.decode().splitlines()[-1])
    if 'error' in result:
        error = result['error']
        raise Failure(error.pop('code'), error.pop('message'), error.pop('hint', ''), **error)
    emit(args, result, ready_text(result, args) + f'\nRunning in the background; stop with `relay down --name {args.name}`.')
    return 0


def cmd_down(args):
    require_linux()
    directory, session = state_dir(args.name), read_session(args.name)
    supervisor = (session or {}).get('supervisor')
    running = alive(supervisor)
    if running:
        os.kill(supervisor['pid'], signal.SIGTERM)
        deadline = time.monotonic() + 20
        while alive(supervisor) and time.monotonic() < deadline:
            time.sleep(0.1)
        if alive(supervisor):
            os.kill(supervisor['pid'], signal.SIGKILL)
            while alive(supervisor):
                time.sleep(0.05)
    if session:
        try:
            held = lock(args.name, directory)
        except Failure:
            held = None
        if held:
            with held:
                session = read_session(args.name) or {}
                if session.get('supervisor') == supervisor:
                    reap(directory, session)
                    if session.get('state') in ('starting', 'ready'):
                        session.update(state='stopped', stopped=time.time())
                        write_session(directory, session)
    emit(args, {'name': args.name, 'stopped': running},
         f'Stopped "{args.name}"' if running else f'"{args.name}" was not running')
    return 0


def cmd_status(args):
    if args.url or os.environ.get('RELAY_URL'):
        where = target(args)
        data = {'url': where[0], 'capabilities': http(where, '/capabilities', args.timeout),
                'metrics': http(where, '/metrics', args.timeout)}
        caps = data['capabilities']
        emit(args, data, f'{where[0]}: up ({caps.get("backend")} {caps.get("width")}x{caps.get("height")}, '
                         f'{data["metrics"].get("frames_encoded")} frames encoded)')
        return 0
    session = read_session(args.name)
    if not session:
        raise Failure('not_running', f'No session named "{args.name}"', 'Start one with `relay up -d`.')
    running = alive(session.get('supervisor'))
    if session.get('state') in ('starting', 'ready') and not running:
        session['state'] = 'dead'
    session.pop('components', None)
    session['running'] = running and session.get('state') == 'ready'
    if args.show_token and session.get('tokenFile') and running:
        session['token'] = Path(session['tokenFile']).read_text().strip()
    if session['running']:
        try:
            session['capabilities'] = http(target(args), '/capabilities', args.timeout)
        except Failure as failure:
            session['health'] = failure.payload()
    lines = [f'{args.name}: {session["state"]}']
    for key in ('url', 'display', 'logs', 'token'):
        if session.get(key):
            lines.append(f'  {key + ":":9}{session[key]}')
    if session.get('error'):
        error = session['error']
        lines += [f'  error:   {error["message"]}', f'  hint:    {error.get("hint", "")}']
        if error.get('log'):
            lines.append('  last log lines:\n' + '\n'.join('    ' + l for l in error['log'].splitlines()))
    emit(args, session, '\n'.join(lines))
    return 0 if session['running'] else 3


def cmd_logs(args):
    directory = state_dir(args.name)
    files = [directory / f'{c}.log' for c in ([args.component] if args.component else COMPONENTS)]
    files = [f for f in files if f.exists()]
    if not files:
        raise Failure('not_running', f'No logs for "{args.name}"', 'Start a session with `relay up`.')
    if args.json:
        if args.follow:
            raise Failure('invalid_input', '--follow cannot be combined with --json')
        emit(args, {f.stem: tail(f, 200) for f in files}, '')
        return 0
    os.execvp('tail', ['tail', '-n', '200', *(['-F'] if args.follow else []), *map(str, files)])


def cmd_run(args):
    require_linux()
    command = args.app[1:] if args.app[:1] == ['--'] else args.app
    if not command:
        raise Failure('invalid_option', 'Name the app to start', 'Example: relay run -- mousepad notes.txt')
    if not shutil.which(command[0]):
        raise Failure('missing_dependency', f'{command[0]} not found', f'Install it first, for example: sudo apt install {command[0]}')
    session = read_session(args.name)
    if not session or session.get('state') != 'ready' or not alive(session.get('supervisor')):
        raise Failure('not_found', f'No running session named "{args.name}"', 'Start one with `relay up -d`.')
    directory = state_dir(args.name)
    env = dict(desktop_env(directory), DISPLAY=session['display'])
    if session.get('xauthority'):
        env['XAUTHORITY'] = session['xauthority']
    path = directory / 'apps.log'
    with open(path, 'ab') as log:
        try:
            process = subprocess.Popen(command, env=env, cwd=Path.home(), stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                                       start_new_session=True, preexec_fn=clear_ambient_caps)
        except OSError as error:
            raise Failure('spawn_failed', f'Cannot start {command[0]}: {error}') from None
    try:
        code = process.wait(1)
    except subprocess.TimeoutExpired:
        code = None
    if code:
        raise Failure('component_failed', f'{command[0]} exited with code {code}', 'Read `relay logs apps`.',
                      component='apps', log=tail(path))
    emit(args, {'pid': process.pid, 'command': command, 'display': session['display'], 'log': str(path)},
         f'Started {command[0]} (pid {process.pid}) on {session["display"]}; output in {path}')
    return 0


def tiny_png():
    def chunk(kind, data):
        return struct.pack('>I', len(data)) + kind + data + struct.pack('>I', zlib.crc32(kind + data))
    return (b'\x89PNG\r\n\x1a\n' + chunk(b'IHDR', struct.pack('>IIBBBBB', 1, 1, 8, 6, 0, 0, 0))
            + chunk(b'IDAT', zlib.compress(b'\0\0\0\0\0')) + chunk(b'IEND', b''))


TINY_SVG = b'<svg xmlns="http://www.w3.org/2000/svg" width="1" height="1"/>'


def icon_probe(library, suffix, data):
    """Decode an image through gdk-pixbuf in a child with ambient caps cleared, as desktop children run."""
    with tempfile.NamedTemporaryFile(suffix=suffix) as image:
        image.write(data)
        image.flush()
        read_fd, write_fd = os.pipe()
        pid = os.fork()
        if pid == 0:
            os.close(read_fd)
            signal.alarm(20)
            message = b''
            try:
                clear_ambient_caps()
                pixbuf = ctypes.CDLL(library)
                pixbuf.gdk_pixbuf_new_from_file.restype = ctypes.c_void_p
                pixbuf.gdk_pixbuf_new_from_file.argtypes = [ctypes.c_char_p, ctypes.POINTER(ctypes.c_void_p)]
                error = ctypes.c_void_p()
                if not pixbuf.gdk_pixbuf_new_from_file(image.name.encode(), ctypes.byref(error)):
                    text = ctypes.cast(error.value + 8, ctypes.POINTER(ctypes.c_char_p)).contents.value if error.value else None
                    message = text or b'decode failed'
            except BaseException as failure:
                message = str(failure).encode() or b'probe failed'
            os.write(write_fd, message)
            os._exit(1 if message else 0)
        os.close(write_fd)
        with os.fdopen(read_fd, 'rb') as stream:
            message = stream.read().decode(errors='replace')
        status = os.waitpid(pid, 0)[1]
    return status == 0, message or ('' if status == 0 else 'probe crashed or timed out')


def cmd_doctor(args):
    checks = []

    def check(name, ok, detail, fix='', level='fail'):
        checks.append({'name': name, 'status': 'ok' if ok else level, 'detail': detail, 'fix': '' if ok else fix})
        return ok

    linux = check('platform', sys.platform.startswith('linux'), sys.platform,
                  'Run doctor on the Linux host; this machine can use client commands with --url.')
    if linux:
        root = os.geteuid() == 0
        sudo = '' if root else 'sudo '
        apt = f'{sudo}apt-get install -y --no-install-recommends '
        check('user', True, 'root' if root else f'uid {os.geteuid()} (not root)')
        check('python3', sys.version_info >= (3, 8), sys.version.split()[0], apt + 'python3')
        check('home', os.access(Path.home(), os.W_OK), str(Path.home()), 'export HOME=/path/to/a/writable/dir')
        state = state_dir('default').parent
        try:
            state.mkdir(parents=True, exist_ok=True)
            writable = os.access(state, os.W_OK)
        except OSError:
            writable = False
        check('state dir', writable, str(state), 'export XDG_STATE_HOME=/path/to/a/writable/dir')
        engine = find_engine()
        runs = bool(engine) and subprocess.run([str(engine), '--help'], capture_output=True).returncode == 0
        check('engine', runs, str(engine or 'relay-engine not found'), './install.sh')
        x264 = ctypes.util.find_library('x264')
        check('libx264', bool(x264), x264 or 'not found',
              apt + "$(apt-cache search --names-only '^libx264-[0-9]+$' | cut -d' ' -f1)")
        for program, package in (('Xvfb', 'xvfb'), ('xauth', 'xauth'), ('xprop', 'x11-utils'),
                                 ('xwininfo', 'x11-utils'), ('xdpyinfo', 'x11-utils')):
            check(program, bool(shutil.which(program)), shutil.which(program) or 'not found', apt + package)
        check('dbus-run-session', bool(shutil.which('dbus-run-session')), shutil.which('dbus-run-session') or 'not found',
              apt + 'dbus', 'warn')
        check('xfce4-session', bool(shutil.which('xfce4-session')), shutil.which('xfce4-session') or 'not found (use --desktop none)',
              './install.sh (or ' + apt + 'xfce4-session xfwm4 xfce4-panel xfdesktop4)', 'warn')
        sockets = Path('/tmp/.X11-unix')
        try:
            info = sockets.stat()
            ok = sockets.is_dir() and ((info.st_mode & 0o1777) == 0o1777 or info.st_uid == os.geteuid())
        except FileNotFoundError:
            ok = os.access('/tmp', os.W_OK)
        check('/tmp/.X11-unix', ok, 'usable' if ok else 'not writable for Xvfb',
              f'{sudo}mkdir -p /tmp/.X11-unix && {sudo}chmod 1777 /tmp/.X11-unix')
        with socket.socket() as probe:
            try:
                probe.bind(('127.0.0.1', DEFAULT_PORT))
                free = True
            except OSError:
                free = False
        check('port', free, f'127.0.0.1:{DEFAULT_PORT} ' + ('free' if free else 'in use'),
              f'relay up --port {DEFAULT_PORT + 1}', 'warn')
        if shutil.which('Xvfb') and shutil.which('xauth') and shutil.which('xdpyinfo'):
            with tempfile.TemporaryDirectory() as scratch:
                auth, children = Path(scratch) / 'auth', []
                auth.write_bytes(b'')

                def spawn(command, **options):
                    children.append(subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                                     start_new_session=True, **options))
                    return children[-1]
                try:
                    display = start_xvfb(spawn, auth)
                    output = x_query(dict(os.environ, DISPLAY=display, XAUTHORITY=str(auth)), 'xdpyinfo')
                    missing = [e for e in ('XTEST', 'DAMAGE', 'XFIXES', 'MIT-SHM') if e not in output]
                    check('X extensions', not missing, 'missing ' + ', '.join(missing) if missing else 'XTEST DAMAGE XFIXES MIT-SHM',
                          'Use the distribution Xvfb; MIT-SHM also needs SysV shared memory (shared IPC namespace).')
                except Failure as failure:
                    check('X extensions', False, failure.message, failure.hint)
                finally:
                    for child in children:
                        child.terminate()
                        child.wait()
        caps = next((l.split()[1] for l in Path('/proc/self/status').read_text().splitlines() if l.startswith('CapAmb:')), '0')
        check('ambient caps', int(caps, 16) == 0, 'none' if int(caps, 16) == 0 else f'{caps}: apps that inherit them crash on icons',
              'Start apps with `relay run -- APP`, which clears them; the desktop and its menus already do.', 'warn')
        library = ctypes.util.find_library('gdk_pixbuf-2.0')
        if library:
            ok, message = icon_probe(library, '.png', tiny_png())
            kind = 'PNG'
            if ok:
                ok, message = icon_probe(library, '.svg', TINY_SVG)
                kind = 'SVG'
            fix = 'See the detail; read `relay logs desktop` after a failed start.'
            if not ok and subprocess.run(['apt-cache', 'show', 'glycin-loaders'], capture_output=True).returncode == 0 \
                    and subprocess.run(['dpkg', '-s', 'glycin-loaders'], capture_output=True).returncode != 0:
                fix = apt + 'glycin-loaders'
            elif not ok and shutil.which('bwrap'):
                sandbox = subprocess.run(['bwrap', '--ro-bind', '/', '/', '--unshare-user', 'true'], capture_output=True,
                                         text=True, preexec_fn=clear_ambient_caps)
                if sandbox.returncode:
                    message += f'; bubblewrap failed: {sandbox.stderr.strip()}'
                    fix = ('Image loaders sandbox with bubblewrap, which needs unprivileged user namespaces: allow them for '
                           'bwrap (AppArmor profile or kernel.unprivileged_userns_clone=1). relay never disables sandboxing.')
            check('icon decoding', ok, 'gdk-pixbuf decodes PNG and SVG' if ok else f'{kind}: {message}', fix,
                  'warn' if kind == 'SVG' else 'fail')
        else:
            check('icon decoding', False, 'gdk-pixbuf not installed (desktop not installed)', './install.sh', 'warn')
    failed = any(c['status'] == 'fail' for c in checks)
    lines = []
    for c in checks:
        lines.append(f'{c["status"]:5} {c["name"]:17} {c["detail"]}')
        if c['fix']:
            lines.append(f'{"":23}fix: {c["fix"]}')
    emit(args, {'ok': not failed, 'checks': checks}, '\n'.join(lines))
    return 1 if failed else 0


def cmd_snapshot(args):
    data = http(target(args), '/snapshot.png', args.timeout, binary=True)
    if data[:8] != b'\x89PNG\r\n\x1a\n' or len(data) < 24:
        raise Failure('internal', 'Engine did not return a PNG')
    width, height = struct.unpack('>II', data[16:24])
    if args.file == '-':
        sys.stdout.buffer.write(data)
        sys.stdout.buffer.flush()
        return 0
    try:
        Path(args.file).write_bytes(data)
    except OSError as error:
        raise Failure('invalid_input', f'Cannot write {args.file}: {error}') from None
    emit(args, {'path': os.path.abspath(args.file), 'bytes': len(data), 'width': width, 'height': height},
         f'Saved {args.file} ({width}x{height}, {len(data)} bytes)')
    return 0


def text_argument(args, value):
    if args.stdin == (value is not None):
        raise Failure('invalid_input', 'Give the argument or --stdin, not both or neither')
    return sys.stdin.read() if args.stdin else value


def finish(args, groups, what):
    applied = send(args, groups)
    emit(args, {'applied': applied}, f'{what} ({applied} events)')
    return 0


def cmd_click(args):
    point = {'x': args.x, 'y': args.y, 'button': {'left': 1, 'middle': 2, 'right': 3}[args.button]}
    return finish(args, [[{'type': 'buttonDown', **point}, {'type': 'buttonUp', **point}]], f'Clicked {args.button} at {args.x:g},{args.y:g}')


def cmd_move(args):
    return finish(args, [[{'type': 'pointerMove', 'x': args.x, 'y': args.y}]], f'Moved to {args.x:g},{args.y:g}')


def cmd_scroll(args):
    if not args.dx and not args.dy:
        raise Failure('invalid_input', 'Nothing to scroll', 'Pass --dy N (positive scrolls down) and/or --dx N.')
    events = [{'type': 'pointerMove', 'x': args.x, 'y': args.y}]
    for axis, notches in (('vertical', args.dy), ('horizontal', args.dx)):
        while notches:
            step = max(-10, min(10, notches))
            events.append({'type': 'wheel', 'axis': axis, 'delta': step * 120, 'x': args.x, 'y': args.y})
            notches -= step
    return finish(args, [events], f'Scrolled dx={args.dx} dy={args.dy}')


def cmd_key(args):
    return finish(args, [combo_events(c) for c in args.combos], 'Pressed ' + ' '.join(args.combos))


def cmd_type(args):
    text = text_argument(args, args.text)
    return finish(args, type_groups(text), f'Typed {len(text)} characters')


def cmd_input(args):
    try:
        events = json.loads(text_argument(args, args.events))
    except ValueError as error:
        raise Failure('invalid_input', f'Invalid JSON: {error}', 'Pass a JSON array of SDK input events.') from None
    if not isinstance(events, list) or not 0 < len(events) <= MAX_BATCH:
        raise Failure('invalid_input', f'Input must be a JSON array of 1 to {MAX_BATCH} events',
                      'Example: [{"type":"keyDown","key":4},{"type":"keyUp","key":4}]')
    return finish(args, [events], 'Sent input')


class Parser(argparse.ArgumentParser):
    """ArgumentParser that raises usage errors as Failures so --json reports them as JSON."""

    def error(self, message):
        raise Failure('invalid_input', message, f'Run `{self.prog} --help`.')


def parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument('--json', action='store_true', help='print machine-readable JSON')
    named = argparse.ArgumentParser(add_help=False)
    named.add_argument('--name', default='default', help='session name (default: default)')
    client = argparse.ArgumentParser(add_help=False, parents=[common, named])
    client.add_argument('--url', help='engine origin (env RELAY_URL; default: the local session)')
    client.add_argument('--token-file', help='file holding the token (env RELAY_TOKEN_FILE)')
    client.add_argument('--timeout', type=float, default=10, help='request timeout in seconds (default: 10)')
    main = Parser(prog='relay', description='Start a streamed Linux desktop and drive it from anywhere.',
                                   epilog='Coordinates are fractions of the screen from 0 to 1. Run `relay COMMAND --help` for details.')
    commands = main.add_subparsers(dest='command', required=True, metavar='COMMAND')

    def add(name, function, help, parents):
        command = commands.add_parser(name, help=help, description=help, parents=parents)
        command.set_defaults(function=function)
        return command

    up = add('up', cmd_up, 'start a display, desktop and engine (foreground; -d for background)', [common, named])
    up.add_argument('-d', '--detach', action='store_true', help='run in the background and return once ready')
    up.add_argument('--port', type=int, default=DEFAULT_PORT, help=f'engine port (default: {DEFAULT_PORT})')
    up.add_argument('--desktop', help='xfce (default), none, or a command to run as the desktop')
    up.add_argument('--display', help='attach to an existing X display such as :0 instead of starting Xvfb')
    up.add_argument('--public', metavar='HTTPS_URL', help='serve behind a TLS proxy at this origin (binds 0.0.0.0, adds a token)')
    up.add_argument('--tls-cert', metavar='FILE', help='serve TLS natively with this certificate')
    up.add_argument('--tls-key', metavar='FILE', help='private key for --tls-cert')
    up.add_argument('--bind', metavar='ADDR', help='listen address (default 127.0.0.1; non-loopback adds a token)')
    up.add_argument('--timeout', type=float, default=30, help='startup timeout in seconds (default: 30)')
    add('down', cmd_down, 'stop a session (safe to repeat)', [common, named])
    status = add('status', cmd_status, 'show a local session, or a remote engine with --url', [client])
    status.add_argument('--show-token', action='store_true', help='include the session token')
    logs = add('logs', cmd_logs, 'print component logs', [common, named])
    logs.add_argument('component', nargs='?', choices=COMPONENTS)
    logs.add_argument('-f', '--follow', action='store_true', help='keep printing new lines')
    add('doctor', cmd_doctor, 'check this machine and print fix commands', [common])
    run = add('run', cmd_run, 'start an app on the session desktop (output: logs apps)', [common, named])
    run.add_argument('app', nargs=argparse.REMAINDER, metavar='-- APP [ARGS...]')
    snapshot = add('snapshot', cmd_snapshot, 'save a PNG of the screen', [client])
    snapshot.add_argument('file', nargs='?', default='screen.png', help='output file, or - for stdout (default: screen.png)')
    click = add('click', cmd_click, 'click at X Y', [client])
    move = add('move', cmd_move, 'move the pointer to X Y', [client])
    scroll = add('scroll', cmd_scroll, 'scroll at X Y by wheel notches', [client])
    for command in (click, move, scroll):
        command.add_argument('x', type=float)
        command.add_argument('y', type=float)
    click.add_argument('--button', choices=('left', 'middle', 'right'), default='left')
    scroll.add_argument('--dx', type=int, default=0, help='notches right (negative: left)')
    scroll.add_argument('--dy', type=int, default=0, help='notches down (negative: up)')
    key = add('key', cmd_key, 'press key combos such as ctrl+l or Enter', [client])
    key.add_argument('combos', nargs='+', metavar='COMBO')
    for name, function, help, dest in (('type', cmd_type, 'type text (US layout)', 'text'),
                                       ('input', cmd_input, 'send a JSON array of SDK input events', 'events')):
        command = add(name, function, help, [client])
        command.add_argument(dest, nargs='?')
        command.add_argument('--stdin', action='store_true', help='read from standard input')
    return main


def main():
    json_mode = '--json' in sys.argv[1:]
    try:
        args = parser().parse_args()
        json_mode = args.json
    except Failure as failure:
        print_failure(failure, json_mode)
        return 2
    try:
        return args.function(args) or 0
    except Failure as failure:
        print_failure(failure, json_mode)
        return 1
    except KeyboardInterrupt:
        return 130


def print_failure(failure, json_mode):
    """Print a Failure on stderr as JSON or as human text with its hint and log tail."""
    if json_mode:
        print(json.dumps({'error': failure.payload()}), file=sys.stderr)
        return
    print(f'error: {failure.message}', file=sys.stderr)
    if failure.hint:
        print(f'hint: {failure.hint}', file=sys.stderr)
    if failure.extra.get('log'):
        print(f'last lines of the {failure.extra.get("component", "")} log:\n{failure.extra["log"]}', file=sys.stderr)


if __name__ == '__main__':
    sys.exit(main())
