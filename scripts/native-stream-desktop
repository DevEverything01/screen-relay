#!/usr/bin/env python3
"""Optional desktop recipe; the streaming engine itself only attaches to DISPLAY."""
import argparse
import json
import os
from pathlib import Path
import secrets
import selectors
import shlex
import shutil
import signal
import ssl
import subprocess
import sys
import tempfile
import time
import urllib.request


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--port', type=int, default=8080)
    parser.add_argument('--bind', default='127.0.0.1')
    parser.add_argument('--session', default='xfce4-session', help='Desktop command, parsed as arguments without a shell')
    parser.add_argument('--no-desktop', action='store_true', help='Start only Xvfb and the engine')
    parser.add_argument('--token-file')
    parser.add_argument('--public-origin')
    parser.add_argument('--tls-cert')
    parser.add_argument('--tls-key')
    parser.add_argument('--behind-tls-proxy', action='store_true')
    args = parser.parse_args()
    if not 1 <= args.port <= 65535:
        parser.error('--port must be between 1 and 65535')
    engine = Path(__file__).resolve().parent / 'native-stream-engine'
    session = shlex.split(args.session)
    programs = ['Xvfb', 'xauth'] + ([] if args.no_desktop else ['dbus-run-session', session[0] if session else ''])
    for program in programs:
        if not program or not shutil.which(program):
            parser.error(f'Missing {program or "session command"}; install desktop dependencies or select --no-desktop')
    if not engine.is_file():
        parser.error('Engine missing beside launcher; run install.sh first')
    state = Path(tempfile.mkdtemp(prefix='native-stream-'))
    runtime = state / 'runtime'
    runtime.mkdir(mode=0o700)
    auth = state / 'Xauthority'
    auth.touch(mode=0o600)
    ice_auth = state / 'ICEauthority'
    ice_auth.touch(mode=0o600)
    cookie = secrets.token_hex(16)
    env = dict(os.environ, XAUTHORITY=str(auth), ICEAUTHORITY=str(ice_auth), XDG_RUNTIME_DIR=str(runtime),
               XDG_CONFIG_HOME=str(state / 'config'), XDG_CACHE_HOME=str(state / 'cache'))
    # A new desktop must not accidentally join the caller's existing D-Bus session.
    env.pop('DBUS_SESSION_BUS_ADDRESS', None)
    children, logs = [], []
    server = None

    def start(command, name, **kwargs):
        log = open(state / (name + '.log'), 'ab')
        logs.append(log)
        process = subprocess.Popen(command, env=env, stdout=log, stderr=log, start_new_session=True, **kwargs)
        children.append(process)
        return process

    def stop(signum, frame):
        raise KeyboardInterrupt

    def authorize(display):
        subprocess.run(['xauth', '-f', str(auth)], input=f'add {display} . {cookie}\n',
                       text=True, check=True, stdout=subprocess.DEVNULL)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        authorize(':0')
        read_fd, write_fd = os.pipe()
        try:
            start(['Xvfb', '-displayfd', str(write_fd), '-screen', '0', '1280x720x24',
                   '-nolisten', 'tcp', '-noreset', '-auth', str(auth)], 'display', pass_fds=(write_fd,))
            os.close(write_fd)
            write_fd = None
            with selectors.DefaultSelector() as selector:
                selector.register(read_fd, selectors.EVENT_READ)
                number = b''
                deadline = time.monotonic() + 15
                while b'\n' not in number:
                    remaining = deadline - time.monotonic()
                    if remaining <= 0 or not selector.select(remaining):
                        raise RuntimeError('Xvfb did not become ready')
                    chunk = os.read(read_fd, 64)
                    if not chunk or len(number) + len(chunk) > 64:
                        raise RuntimeError('Xvfb failed to report a display number')
                    number += chunk
                display = number.decode().strip()
            if not display.isdigit():
                raise RuntimeError('Xvfb failed to allocate a display')
        finally:
            os.close(read_fd)
            if write_fd is not None:
                os.close(write_fd)
        env['DISPLAY'] = ':' + display
        authorize(env['DISPLAY'])
        if not args.no_desktop:
            start(['dbus-run-session', '--', *session], 'desktop')
        command = [str(engine), '--bind', args.bind, '--port', str(args.port)]
        for option in ['token_file', 'public_origin', 'tls_cert', 'tls_key']:
            value = getattr(args, option)
            if value:
                command += ['--' + option.replace('_', '-'), value]
        if args.behind_tls_proxy:
            command.append('--behind-tls-proxy')
        server = start(command, 'engine')
        token = Path(args.token_file).read_text().strip() if args.token_file else ''
        headers = {'Host': f'localhost:{args.port}'}
        if token:
            headers['Authorization'] = 'Bearer ' + token
        scheme = 'https' if args.tls_cert else 'http'
        probe_host = '127.0.0.1' if args.bind == '0.0.0.0' else args.bind
        local_url = f'{scheme}://{probe_host}:{args.port}'
        context = None
        if args.tls_cert:
            context = ssl.create_default_context(cafile=args.tls_cert)
            # Health probe is pinned to the configured certificate on loopback, not its public hostname.
            context.check_hostname = False
        deadline = time.monotonic() + 20
        while True:
            if any(child.poll() is not None for child in children):
                raise RuntimeError('A desktop component exited during startup')
            try:
                own_listener = False
                for line in (state / 'engine.log').read_text(errors='replace').splitlines():
                    if line.startswith('{'):
                        message = json.loads(line)
                        own_listener |= message.get('ready') is True and message.get('pid') == server.pid
                if not own_listener:
                    raise OSError('Waiting for this engine to bind its port')
                request = urllib.request.Request(local_url + '/snapshot.png', headers=headers)
                with urllib.request.urlopen(request, timeout=2, context=context) as response:
                    if response.read(8) != b'\x89PNG\r\n\x1a\n':
                        raise RuntimeError('Engine did not return a PNG')
                break
            except (OSError, urllib.error.URLError):
                if time.monotonic() >= deadline:
                    raise RuntimeError('Engine did not produce a screenshot before the startup deadline')
                time.sleep(0.1)
        print(json.dumps({'ready': True, 'url': args.public_origin or local_url,
                          'display': env['DISPLAY'], 'xauthority': str(auth),
                          'pid': os.getpid(), 'enginePid': server.pid, 'logs': str(state)}), flush=True)
        while all(child.poll() is None for child in children):
            time.sleep(0.2)
        raise RuntimeError('A desktop component exited; stopping this session')
    except KeyboardInterrupt:
        return 0
    except Exception as error:
        print(json.dumps({'ready': False, 'error': str(error), 'logs': str(state)}), file=sys.stderr)
        return 1
    finally:
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        signal.signal(signal.SIGINT, signal.SIG_IGN)
        if server is not None and server.poll() is None:
            server.terminate()
            try:
                server.wait(timeout=3)
            except subprocess.TimeoutExpired:
                server.kill()
                server.wait()
        for child in reversed(children):
            try:
                os.killpg(child.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
        for child in reversed(children):
            try:
                child.wait(timeout=3)
            except subprocess.TimeoutExpired:
                os.killpg(child.pid, signal.SIGKILL)
                child.wait()
        for log in logs:
            log.close()


if __name__ == '__main__':
    sys.exit(main())
